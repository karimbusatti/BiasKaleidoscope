generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunMode {
  sandbox
  hr
}

enum RunStatus {
  pending
  processing
  completed
  failed
}

enum ArtifactType {
  JD
  CV
  Prompt
  Dataset
}

enum ReportStatus {
  draft
  ready
  archived
}

enum BillingPlan {
  FREE
  PRO
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  users     User[]
  projects  Project[]
  billing   Billing?
  createdAt DateTime  @default(now())
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  runs           Run[]
  apiKeys        ApiKey[]
  createdAt      DateTime  @default(now())
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  runs           Run[]
  artifacts      Artifact[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Run {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  mode        RunMode
  inputsJson  Json
  variantsJson Json?
  metricsJson Json?
  status      RunStatus  @default(pending)
  createdAt   DateTime   @default(now())
  artifacts   Artifact[]
  report      Report?
}

model Artifact {
  id             String       @id @default(cuid())
  type           ArtifactType
  contentMeta    Json
  storagePointer String?
  runId          String?
  run            Run?        @relation(fields: [runId], references: [id])
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id])
  createdAt      DateTime    @default(now())
}

model Report {
  id              String       @id @default(cuid())
  runId           String       @unique
  run             Run          @relation(fields: [runId], references: [id])
  publicId        String       @unique
  status          ReportStatus @default(draft)
  pdfPointer      String?
  signatureSha256 String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model Billing {
  id             String      @id @default(cuid())
  organizationId String      @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  plan           BillingPlan @default(FREE)
  seats          Int         @default(5)
  renewsAt       DateTime?
  createdAt      DateTime    @default(now())
}
